# Parameters for ConditionedTrainerModuleTransformer:
# ==============================================================================
ConditionedTrainerModuleTransformer.async_checkpointing = True
ConditionedTrainerModuleTransformer.base_log_dir = 'checkpoints/'
ConditionedTrainerModuleTransformer.callbacks_every_n_epochs = 50
ConditionedTrainerModuleTransformer.check_val_every_n_epoch = 10
ConditionedTrainerModuleTransformer.curriculum_growth_rate = 2.0
ConditionedTrainerModuleTransformer.curriculum_min_length = 12
ConditionedTrainerModuleTransformer.curriculum_schedule = None
ConditionedTrainerModuleTransformer.curriculum_type = None
ConditionedTrainerModuleTransformer.curriculum_warmup_epochs = 500
ConditionedTrainerModuleTransformer.debug = False
ConditionedTrainerModuleTransformer.end_value = 2.5e-05
ConditionedTrainerModuleTransformer.gradient_clip = 1.0
ConditionedTrainerModuleTransformer.learning_rate = 0.0003
ConditionedTrainerModuleTransformer.learning_schedule = \
    'warmup_cosine_decay'
ConditionedTrainerModuleTransformer.load_checkpoint = False
ConditionedTrainerModuleTransformer.log_every_n_steps = 10
ConditionedTrainerModuleTransformer.loss_type = 'mse'
ConditionedTrainerModuleTransformer.optimizer = @adam
ConditionedTrainerModuleTransformer.print_model_summary = False
ConditionedTrainerModuleTransformer.save_config = True
ConditionedTrainerModuleTransformer.seed = 42
ConditionedTrainerModuleTransformer.ss_max_ratio = 50
ConditionedTrainerModuleTransformer.ss_ramp_epochs = 1000
ConditionedTrainerModuleTransformer.ss_start_epoch = 50
ConditionedTrainerModuleTransformer.verify_sharding = False
ConditionedTrainerModuleTransformer.warmup_steps = 500
ConditionedTrainerModuleTransformer.weight_decay = 0.0

