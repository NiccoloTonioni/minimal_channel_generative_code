# Base Configuration for  VAE-GAN Training 
# This file configures the training for VAE with adversarial loss
include "configs/base/vae_gan/model_architecture.gin"

# =============================================================================
# RUN SEED (for randomness)
# =============================================================================
SEED = 42

# =============================================================================
# MAIN FUNCTION CONFIGURATION
# =============================================================================
main_autoencoder.train = True
main_autoencoder.save_reconstructions = False
main_autoencoder.use_vae_gan = True  # Set to False for standard VAE training

# Directories paths
# Set to the root of your local clone
main_autoencoder.working_directory = '/lustre/fsn1/projects/rech/brp/ume68kh/MinimalChannel/2D/FlowModel'
main_autoencoder.data_root_relative='src/data/datasets/flow'
main_autoencoder.log_dir_relative='pretrained_models/checkpoints_vae_gan'

# =============================================================================
# DATALOADER CONFIGURATION
# =============================================================================
data_loader.dataset_name = 'minimal_channel_flow'
data_loader.batch_size = 32
data_loader.seed = %SEED
data_loader.split_seed = 42   # fixed across runs, do not change

# =============================================================================
# TRAINING FUNCTION CONFIGURATION
# =============================================================================
train_vae_gan.epochs = 2000

# =============================================================================
# TRAINER MODULE CONFIGURATION
# =============================================================================
TrainerModuleVAEGAN.seed = %SEED
TrainerModuleVAEGAN.load_checkpoint = False
TrainerModuleVAEGAN.async_checkpointing = True
TrainerModuleVAEGAN.debug = False
TrainerModuleVAEGAN.print_model_summary = False
TrainerModuleVAEGAN.verify_sharding = False

# Training schedule configuration
TrainerModuleVAEGAN.update_gen_every_n_steps = 1
TrainerModuleVAEGAN.update_disc_every_n_steps = 2

# Training loop configuration
TrainerModuleVAEGAN.check_val_every_n_epochs = 10     
TrainerModuleVAEGAN.callbacks_every_n_epochs = 20      

# Logging configuration
TrainerModuleVAEGAN.log_every_n_steps = 20
TrainerModuleVAEGAN.save_config = True

# =============================================================================
# OPTIMIZER PARAMETERS
# =============================================================================
# Generator (VAE) optimizer configuration
TrainerModuleVAEGAN.generator_optimizer = @adam
TrainerModuleVAEGAN.generator_learning_schedule = 'warmup_cosine_decay'    
TrainerModuleVAEGAN.generator_learning_rate = 1e-3
TrainerModuleVAEGAN.generator_end_value = 1e-5
TrainerModuleVAEGAN.generator_warmup_steps = 500          
TrainerModuleVAEGAN.generator_gradient_clip = 1.0
TrainerModuleVAEGAN.generator_weight_decay = 0.0

# Discriminator optimizer configuration
TrainerModuleVAEGAN.discriminator_optimizer = @adam
TrainerModuleVAEGAN.discriminator_learning_schedule = 'warmup_cosine_decay'
TrainerModuleVAEGAN.discriminator_learning_rate = 1e-3
TrainerModuleVAEGAN.discriminator_end_value = 1e-5   
TrainerModuleVAEGAN.discriminator_warmup_steps = 500      
TrainerModuleVAEGAN.discriminator_gradient_clip = 1.0
TrainerModuleVAEGAN.discriminator_weight_decay = 0.0

# =============================================================================
# LOSS PARAMETERS (BETA AND ALFA SCHEDULING)
# =============================================================================
# VAE KL loss weight scheduling (β)
TrainerModuleVAEGAN.beta_schedule = 'cyclic_linear'
TrainerModuleVAEGAN.beta_start_value = 0.0
TrainerModuleVAEGAN.beta_end_value = 1e-3
TrainerModuleVAEGAN.beta_n_cycles = 2
TrainerModuleVAEGAN.beta_warmup = 150            
TrainerModuleVAEGAN.beta_freeze_epochs = 0         

# Adversarial loss weight (α)
TrainerModuleVAEGAN.alfa_schedule = 'linear'
TrainerModuleVAEGAN.alfa_start_value = 0.0
TrainerModuleVAEGAN.alfa_end_value = 1e-3
TrainerModuleVAEGAN.alfa_warmup = 150           
TrainerModuleVAEGAN.alfa_freeze_epochs = 50   

