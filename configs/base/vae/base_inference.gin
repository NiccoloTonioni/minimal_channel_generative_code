# Base Configuration for VAE Inference
# This file contains the main inference configuration, path settings, and dataloader parameters
include "./configs/base/vae/model_architecture.gin"

# =============================================================================
# MAIN FUNCTION CONFIGURATION
# =============================================================================
main_autoencoder.train = False
main_autoencoder.save_reconstructions = True
main_autoencoder.use_vae_gan = False  # Set to False for standard VAE inference

# Directories paths
# Paths are relative to the repository root
main_autoencoder.working_directory = '.'   # repository root; run the scripts from here
main_autoencoder.data_root_relative='src/data/datasets/flow'
# Run directory of a trained beta-VAE (contains best_model_params/). The training writes it to
# checkpoints/vae/ld_<d_zeta>_fc_6_sd_<seed>, e.g. checkpoints/vae/ld_4_fc_6_sd_42
main_autoencoder.log_dir_relative='path/to/vae_run'

# =============================================================================
# DATALOADER CONFIGURATION
# =============================================================================
data_loader.dataset_name = 'minimal_channel_flow'
data_loader.batch_size = 100