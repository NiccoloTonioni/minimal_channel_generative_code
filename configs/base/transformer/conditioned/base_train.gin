# Base Configuration for  VAE-GAN Training 
# This file configures the training for VAE with adversarial loss
include "configs/base/transformer/conditioned/adaLn_transformer_arch.gin"

# =============================================================================
# RUN SEED (for randomness)
# =============================================================================
SEED = 42

# =============================================================================
# MAIN FUNCTION CONFIGURATION
# =============================================================================
main_transformer.train = True
main_transformer.save_rollout = False
main_transformer.model_type = 'conditioned_adaLN_transformer'
# Directories paths — set to the root of your local clone
main_transformer.working_directory = '/path/to/your/project'
main_transformer.latent_root_relative='src/data/datasets/latents'
main_transformer.sensor_root_relative='src/data/datasets/sensors'
main_transformer.log_dir_relative='pretrained_models/checkpoints_transformer/'

# =============================================================================
# DATALOADER CONFIGURATION
# =============================================================================
latent_data_loader.batch_size = 32
latent_data_loader.seed = %SEED

# =============================================================================
# TRAINING FUNCTION CONFIGURATION
# =============================================================================
train_conditioned_transformer.epochs = 2000

# =============================================================================
# TRAINER MODULE CONFIGURATION
# =============================================================================
# Run seed (set by the SEED macro above)
ConditionedTrainerModuleTransformer.seed = %SEED
# Load from checkpoint? 
ConditionedTrainerModuleTransformer.load_checkpoint = False
# Debugging and model summary
ConditionedTrainerModuleTransformer.debug = False
ConditionedTrainerModuleTransformer.print_model_summary = False
ConditionedTrainerModuleTransformer.verify_sharding = False
# Training loop configuration
ConditionedTrainerModuleTransformer.check_val_every_n_epoch = 10
ConditionedTrainerModuleTransformer.callbacks_every_n_epochs = 50
# Logging configuration
ConditionedTrainerModuleTransformer.save_config = True

# =============================================================================
# TRAINER CURRICULUM SCHEDULER CONFIGURATION (OPTIONAL)
# =============================================================================
ConditionedTrainerModuleTransformer.curriculum_type = None       # Options: None, 'linear', 'exponential'
ConditionedTrainerModuleTransformer.curriculum_warmup_epochs = 500   # Number of epochs to reach max length
ConditionedTrainerModuleTransformer.curriculum_min_length = 12       # Minimum sequence length for curriculum learning
ConditionedTrainerModuleTransformer.curriculum_schedule = None       # If step curriculum you have to provide a list of (epoch, length) tuples
ConditionedTrainerModuleTransformer.curriculum_growth_rate = 2.0     # Growth rate for exponential curriculum

# =============================================================================
# TRAINER SCHEDULED SAMPLING CONFIGURATION (OPTIONAL)
# =============================================================================
ConditionedTrainerModuleTransformer.ss_start_epoch = 50          # Epoch to start scheduled sampling
ConditionedTrainerModuleTransformer.ss_max_ratio = 0.5           # Max fraction of predictions used as input (0–1)
ConditionedTrainerModuleTransformer.ss_ramp_epochs = 1000         # Number of epochs to reach max scheduled sampling ratio

# =============================================================================
# TRAINER INPUT NOISE CONFIGURATION (OPTIONAL)
# =============================================================================
ConditionedTrainerModuleTransformer.use_input_noise = False         # Add Gaussian noise to the input after scheduled sampling
ConditionedTrainerModuleTransformer.input_noise_std = 0.01          # Standard deviation of the injected noise (sigma_n)

# =============================================================================
# OPTIMIZER PARAMETERS
# =============================================================================
# Transformer optimizer configuration
ConditionedTrainerModuleTransformer.optimizer = @adam
ConditionedTrainerModuleTransformer.learning_rate = 3e-4
ConditionedTrainerModuleTransformer.learning_schedule = 'warmup_cosine_decay'
ConditionedTrainerModuleTransformer.warmup_steps = 500
ConditionedTrainerModuleTransformer.end_value = 2.5e-5
ConditionedTrainerModuleTransformer.gradient_clip = 1.0
ConditionedTrainerModuleTransformer.weight_decay = 0.0

# =============================================================================
# LOSS PARAMETERS 
# =============================================================================
# Loss type to use
ConditionedTrainerModuleTransformer.loss_type = 'mse'  # Options: 'mse', 'mae', 'huber' or time-weighted 'tw_mse', 'tw_mae', 'tw_huber'
# Temporal weighting factor delta in (0, 1], used only by the 'tw_*' losses
ConditionedTrainerModuleTransformer.time_weight_delta = 0.98
