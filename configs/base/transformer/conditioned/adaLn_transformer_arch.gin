# =============================================================================
# ADALN CONDITIONED TIME TRANSFORMER CONFIGURATION
# =============================================================================
TimeTransformerAdaLNZero.block_size = 128
TimeTransformerAdaLNZero.cond_dim = 18
TimeTransformerAdaLNZero.dropout_rate = 0.1
TimeTransformerAdaLNZero.k_cond = 3
TimeTransformerAdaLNZero.k_emb = 3
TimeTransformerAdaLNZero.n_embd = 64
TimeTransformerAdaLNZero.n_heads = 4
TimeTransformerAdaLNZero.n_layer = 4
TimeTransformerAdaLNZero.use_bias = False

# =============================================================================
# ATTENTION CONFIGURATION
# =============================================================================
TimeTransformerAdaLNZero.attention_type = 'easy_attention'   # EA* in the paper. Options: 'self_attention', 'easy_attention', 'self_easy_attention'
TimeTransformerAdaLNZero.ea_sparse_offset = None             # Easy attention: None = dense alpha, int = banded alpha with this offset
TimeTransformerAdaLNZero.ea_init_alpha = 'xavier'            # Easy attention alpha init: 'eye', 'xavier', 'randn'
TimeTransformerAdaLNZero.ea_init_wv = 'randn'                # Easy attention value projection init: 'xavier', 'randn'
